DATABASE_URL=postgres://loguser:logpass@localhost:5433/logexplorer
PORT=3000

JWT_SECRET=dev-only-change-me-32-bytes-min
JWT_EXPIRES_IN=60m
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5173

AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=60000
INGEST_RATE_LIMIT_MAX=1000
INGEST_RATE_LIMIT_WINDOW_MS=60000

SEARCH_STATEMENT_TIMEOUT_MS=5000
SEARCH_MAX_RANGE_DAYS=30

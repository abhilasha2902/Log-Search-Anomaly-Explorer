DATABASE_URL=postgres://loguser:logpass@localhost:5433/logexplorer
PORT=3000

JWT_SECRET=dev-only-change-me-32-bytes-min
JWT_EXPIRES_IN=60m
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5173

AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=60000
INGEST_RATE_LIMIT_MAX=1000
INGEST_RATE_LIMIT_WINDOW_MS=60000

SEARCH_STATEMENT_TIMEOUT_MS=5000
SEARCH_MAX_RANGE_DAYS=30

# Anomaly detector (worker). All optional; these are the defaults.
WORKER_INTERVAL_MS=60000
NEW_TEMPLATE_WINDOW_MINUTES=10
SERVICE_WARMUP_MINUTES=10
RATE_EWMA_ALPHA=0.2
RATE_Z_THRESHOLD=4
RATE_MIN_COUNT=10
RATE_MIN_HISTORY_MINUTES=10
RATE_LOOKBACK_MINUTES=120
SPIKE_MERGE_GAP_MINUTES=2
